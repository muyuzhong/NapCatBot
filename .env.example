NAPCAT_UID=1000
NAPCAT_GID=1000
WEBUI_TOKEN=
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_COMPRESS_AT=0.8
LLM_SUMMARY_TURNS=8
# 意图识别的判断模型（便宜快的 Flash）；留空则退回 LLM_MODEL，只是慢一些
LLM_DECIDE_URL=
LLM_DECIDE_KEY=
LLM_DECIDE_MODEL=
LLM_DECIDE_MAX_TOKENS=128
# 追问判定窗口：机器人提问后多久内，被问的人回话算"在回答我"
INTENT_ANSWER_WINDOW_MS=300000
INTENT_HISTORY=6
# 消息聚合：同一会话连发时攒批处理；私聊/群聊的 debounce 窗口、单批最长等待与条数上限
BATCH_PRIVATE_MS=2500
BATCH_GROUP_MS=5000
BATCH_MAX_WAIT_MS=10000
BATCH_MAX_BATCH=10
# 提示词目录：system.txt 人格、decide.txt 参与判断、summary.txt 压缩摘要、memory-*.txt 长期记忆；改完不用重启
PROMPTS_DIR=prompts
# 长期记忆（LanceDB）：0 关闭整套记忆；目录里存 profiles / events 两张表
MEMORY_ENABLED=1
MEMORY_DIR=data/memory
# 一段聊天安静多久算"这段聊完了"，之后才提取长期记忆
MEMORY_IDLE_MS=180000
MEMORY_SEGMENT_MESSAGES=12
MEMORY_MIN_MESSAGES=2
# 事件记忆：最多注入几条、相似度阈值（cosine distance，越小越严）、低于这个重要度不记
MEMORY_RECALL_EVENTS=2
MEMORY_MAX_DISTANCE=0.45
MEMORY_MIN_IMPORTANCE=0.4
# 记忆提取/合并用的模型；留空退回 LLM_DECIDE_MODEL，再退回 LLM_MODEL
LLM_MEMORY_URL=
LLM_MEMORY_KEY=
LLM_MEMORY_MODEL=
LLM_MEMORY_MAX_TOKENS=1024
# 向量化（事件记忆检索用）。不配就只保留画像精确过滤，事件检索自动跳过。
# 实测：coding plan 端点（.../api/coding/v3）只有 doubao-embedding-vision-250328 可用（2048 维；
# doubao-embed、doubao-embedding-text-240715 都会返回 UnsupportedModel）。标准方舟端点可用 doubao-embedding-text-240715 等。
# 向量维度按第一次写入自动适配，换 embedding 模型要清空 MEMORY_DIR 重建。
LLM_EMBED_URL=
LLM_EMBED_KEY=
LLM_EMBED_MODEL=
